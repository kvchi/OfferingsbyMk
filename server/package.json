{
  "name": "shopsphare-server",
  "version": "1.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "validate": "prisma validate && node --check app.js && node --check routes/auth.js && node --check middleware/authenticate.js && node --check config/env.js && node --check scripts/run-tests.js && node --check test/auth.smoke.test.js",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.18.0",
    "supertest": "^7.2.2"
  }
}
