{
  "watch": [
    "app.js",
    "config",
    "middleware",
    "routes",
    "commerce",
    "package.json",
    "prisma/schema.prisma"
  ],
  "ext": "js,mjs,cjs,json,prisma",
  "ignore": [
    "node_modules/**",
    "prisma/*.db",
    "prisma/*.db-journal",
    "prisma/dev.db",
    "prisma/dev.db-journal",
    "prisma/*.db-wal",
    "prisma/*.db-shm",
    "prisma/test*.db",
    "prisma/test*.db-*",
    "coverage/**",
    ".nyc_output/**",
    "logs/**",
    "tmp/**",
    "temp/**",
    "**/*.log",
    "**/*.tmp"
  ]
}
